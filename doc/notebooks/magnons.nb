Notebook[{Cell["Spin waves in a staggered field", "Title"], 
  Cell["Second Quantization with SNEG | Chapter 12", "Subtitle"], 
  Cell["Start a fresh Mathematica kernel with SNEG installed. Evaluate the \
cells in order.", "Text"], 
  Cell[BoxData[RowBox[{"Needs", "[", "\"sneg`\"", "]"}]], "Input"], 
  Cell["Spin waves of a finite antiferromagnet", "Subsubsection"], 
  Cell[TextData[
    {"The Heisenberg ring with four spins 1/2 in a staggered field, ", 
     Cell[BoxData[FormBox[RowBox[{"H", "=", "J", UnderscriptBox["\[Sum]", 
           "i"], SubscriptBox[StyleBox["S", FontWeight -> "Bold", 
            FontSlant -> "Plain"], "i"], "\[CenterDot]", 
          SubscriptBox[StyleBox["S", FontWeight -> "Bold", 
            FontSlant -> "Plain"], RowBox[{"i", "+", "1"}]], "-", "h", 
          UnderscriptBox["\[Sum]", "i"], "(", "-", "1", SuperscriptBox[")", 
           RowBox[{"i", "+", "1"}]], SubsuperscriptBox["S", "i", "z"]}], 
        TraditionalForm]], "InlineFormula"], ", expanded with \
Holstein-Primakoff bosons around the N\[EAcute]el state (sublattice B rotated \
by ", Cell[BoxData[FormBox["\[Pi]", TraditionalForm]], "InlineFormula"], 
     " about ", Cell[BoxData[FormBox["x", TraditionalForm]], 
      "InlineFormula"], "). The magnon energies are ", 
     Cell[BoxData[FormBox[SqrtBox[RowBox[{"(", "1", "+", "h", 
           SuperscriptBox[")", "2"], "-", SuperscriptBox[StyleBox["cos", 
             FontSlant -> "Plain"], "2"], "k"}]], TraditionalForm]], 
      "InlineFormula"], ", ", 
     Cell[BoxData[FormBox[RowBox[{"k", "=", "0", ",", "\[PlusMinus]", 
          "\[Pi]", "/", "2", ",", "\[Pi]"}], TraditionalForm]], 
      "InlineFormula"], ", in units of ", 
     Cell[BoxData[FormBox["J", TraditionalForm]], "InlineFormula"], ", and ", 
     Cell[BoxData[FormBox[SubscriptBox["E", StyleBox["gs", 
          FontSlant -> "Plain"]], TraditionalForm]], "InlineFormula"], 
     " includes the zero-point energy:"}], "Text"], 
  Cell[CellGroupData[
    {Cell[BoxData[{RowBox[{RowBox[{"snegspinoperators", "[", 
            RowBox[{"{", RowBox[{"S", ",", " ", RowBox[{"1", "/", "2"}]}], 
              "}"}], "]"}], ";"}], "\n", 
        RowBox[{RowBox[{"snegbosonoperators", "[", "b", "]"}], ";"}], "\n", 
        RowBox[{RowBox[{"snegrealconstants", "[", "hs", "]"}], ";"}], "\n", 
        RowBox[{RowBox[{"h", " ", "=", " ", RowBox[{RowBox[{"Sum", "[", 
                RowBox[{RowBox[{"spinspin", "[", RowBox[{RowBox[{"S", "[", 
                        "i", "]"}], ",", " ", RowBox[{"S", "[", RowBox[
                         {RowBox[{"Mod", "[", RowBox[{"i", ",", " ", "4"}], 
                          "]"}], " ", "+", " ", "1"}], "]"}]}], "]"}], ",", 
                  " ", RowBox[{"{", RowBox[{"i", ",", " ", "4"}], "}"}]}], 
                "]"}], " ", "-", " ", RowBox[{"hs", " ", RowBox[{"Sum", "[", 
                  RowBox[{RowBox[{RowBox[{RowBox[{"(", RowBox[{"-", "1"}], 
                          ")"}], "^", RowBox[{"(", RowBox[{"i", " ", "+", 
                          " ", "1"}], ")"}]}], " ", RowBox[{"S", "[", 
                        RowBox[{"i", ",", " ", "3"}], "]"}]}], ",", " ", 
                    RowBox[{"{", RowBox[{"i", ",", " ", "4"}], "}"}]}], 
                  "]"}]}]}]}], ";"}], "\n", 
        RowBox[{RowBox[{"h", " ", "=", " ", RowBox[{"rotatespin", "[", 
              RowBox[{"h", ",", " ", "S", ",", " ", RowBox[
                 {RowBox[{"If", "[", RowBox[{RowBox[{"EvenQ", "[", RowBox[
                         {"First", "[", RowBox[{"{", "##", "}"}], "]"}], 
                        "]"}], ",", " ", RowBox[{"RotationMatrix", "[", 
                        RowBox[{"Pi", ",", " ", RowBox[{"{", RowBox[{"1", 
                          ",", " ", "0", ",", " ", "0"}], "}"}]}], "]"}], 
                      ",", " ", RowBox[{"IdentityMatrix", "[", "3", "]"}]}], 
                    "]"}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
        RowBox[{RowBox[{"hb", " ", "=", " ", RowBox[{"holsteinprimakoff", 
              "[", RowBox[{"h", ",", " ", RowBox[{"S", " ", "->", " ", "b"}], 
                ",", " ", "2"}], "]"}]}], ";"}], "\n", 
        RowBox[{RowBox[{RowBox[{"{", RowBox[{"\[Epsilon]", ",", " ", "T", 
                ",", " ", "Egs"}], "}"}], " ", "=", " ", 
            RowBox[{"bogoliubov", "[", RowBox[{RowBox[{"hb", " ", "/.", " ", 
                  RowBox[{"hs", " ", "->", " ", RowBox[{"1", "/", "10"}]}]}], 
                ",", " ", RowBox[{"Table", "[", RowBox[{RowBox[{"b", "[", 
                      "i", "]"}], ",", " ", RowBox[{"{", RowBox[{"i", ",", 
                        " ", "4"}], "}"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
        RowBox[{"{", RowBox[{"\[Epsilon]", ",", " ", "Egs"}], "}"}]}], 
      "Input", CellLabel -> "In[1]:="], 
     Cell[BoxData[RowBox[{"{", RowBox[
          {RowBox[{"{", RowBox[{"0.45825756949558444`", ",", 
               "0.4582575694955846`", ",", "1.1`", ",", 
               "1.1000000000000003`"}], "}"}], ",", 
           RowBox[{"-", "1.8417424305044152`"}]}], "}"}]], "Output", 
      CellLabel -> "Out[8]="]}, Open]], 
  Cell[CellGroupData[
    {Cell[BoxData[RowBox[{"N", "[", RowBox[{"Sqrt", "[", 
           RowBox[{RowBox[{RowBox[{"(", RowBox[{"1", " ", "+", " ", 
                   RowBox[{"1", "/", "10"}]}], ")"}], "^", "2"}], " ", "-", 
             " ", RowBox[{RowBox[{"Cos", "[", RowBox[{"{", RowBox[{"0", ",", 
                     " ", RowBox[{"Pi", "/", "2"}], ",", " ", RowBox[
                      {"Pi", "/", "2"}], ",", " ", "Pi"}], "}"}], "]"}], "^", 
               "2"}]}], "]"}], "]"}]], "Input", CellLabel -> "In[9]:="], 
     Cell[BoxData[RowBox[{"{", RowBox[{"0.458257569495584`", ",", "1.1`", 
           ",", "1.1`", ",", "0.458257569495584`"}], "}"}]], "Output", 
      CellLabel -> "Out[9]="]}, Open]], Cell["Source: Second Quantization \
with SNEG, SNEG documentation project. Licensed under Creative Commons \
Attribution 4.0 International \
(https://creativecommons.org/licenses/by/4.0/).", "Text"]}, 
 StyleDefinitions -> "Default.nb", WindowTitle -> 
  "Spin waves in a staggered field"]
