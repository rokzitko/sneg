           "1.0296990620785584`"}], "}"}]], "Output", 
      CellLabel -> "Out[7]="]}, Open]], 
  Cell[TextData[{"The same gap follows from the self-consistent mean-field \
solution of the attractive Hubbard ring with ", 
     Cell[BoxData[StyleBox["meanfieldsolve", "TI"]], "InlineFormula"], "."}], 
   "Text"], Cell["Source: Second Quantization with SNEG, SNEG documentation \
project. Licensed under Creative Commons Attribution 4.0 International \
(https://creativecommons.org/licenses/by/4.0/).", "Text"]}, 
 StyleDefinitions -> "Default.nb", WindowTitle -> 
  "The finite-temperature BCS gap equation"]
