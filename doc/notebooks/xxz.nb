Notebook[{Cell["The Jordan-Wigner transformation of the XXZ chain", "Title"], 
  Cell["Second Quantization with SNEG | Chapter 12", "Subtitle"], 
  Cell["Start a fresh Mathematica kernel with SNEG installed. Evaluate the \
cells in order.", "Text"], 
  Cell[BoxData[RowBox[{"Needs", "[", "\"sneg`\"", "]"}]], "Input"], 
  Cell[TextData[{"XXZ chain of four sites, ", 
     Cell[BoxData[FormBox[RowBox[{"H", "=", UnderscriptBox["\[Sum]", "i"], 
          "[", FractionBox["J", "2"], "(", SubsuperscriptBox["S", "i", "+"], 
          SubsuperscriptBox["S", RowBox[{"i", "+", "1"}], "-"], "+", 
          SubsuperscriptBox["S", "i", "-"], SubsuperscriptBox["S", 
           RowBox[{"i", "+", "1"}], "+"], ")", "+", SubscriptBox["J", "z"], 
          SubsuperscriptBox["S", "i", "z"], SubsuperscriptBox["S", 
           RowBox[{"i", "+", "1"}], "z"], "]"}], TraditionalForm]], 
      "InlineFormula"], ". The transverse part gives nearest-neighbor \
hopping, the longitudinal part a nearest-neighbor interaction:"}], "Text"], 
  Cell[CellGroupData[
    {Cell[BoxData[{RowBox[{RowBox[{"snegspinoperators", "[", 
            RowBox[{"{", RowBox[{"S", ",", " ", RowBox[{"1", "/", "2"}]}], 
              "}"}], "]"}], ";"}], "\n", 
        RowBox[{RowBox[{"snegspinlessfermionoperators", "[", "f", "]"}], 
          ";"}], "\n", RowBox[{RowBox[{"snegrealconstants", "[", 
            RowBox[{"J", ",", " ", "Jz"}], "]"}], ";"}], "\n", 
        RowBox[{RowBox[{"H", " ", "=", " ", RowBox[{"Sum", "[", 
              RowBox[{RowBox[{RowBox[{RowBox[{"J", "/", "2"}], " ", 
                    RowBox[{"(", RowBox[{RowBox[{"nc", "[", RowBox[
                          {RowBox[{"S", "[", RowBox[{"i", ",", " ", "4"}], 
                          "]"}], ",", " ", RowBox[{"S", "[", RowBox[{RowBox[
                          {"i", " ", "+", " ", "1"}], ",", " ", "5"}], 
                          "]"}]}], "]"}], " ", "+", " ", RowBox[{"nc", "[", 
                          RowBox[{RowBox[{"S", "[", RowBox[{"i", ",", " ", 
                          "5"}], "]"}], ",", " ", RowBox[{"S", "[", RowBox[
                          {RowBox[{"i", " ", "+", " ", "1"}], ",", " ", 
                          "4"}], "]"}]}], "]"}]}], ")"}]}], " ", "+", " ", 
                  RowBox[{"Jz", " ", RowBox[{"nc", "[", RowBox[{RowBox[
                         {"S", "[", RowBox[{"i", ",", " ", "3"}], "]"}], ",", 
                        " ", RowBox[{"S", "[", RowBox[{RowBox[{"i", " ", "+", 
                          " ", "1"}], ",", " ", "3"}], "]"}]}], "]"}]}]}], 
                ",", " ", RowBox[{"{", RowBox[{"i", ",", " ", "3"}], "}"}]}], 
              "]"}]}], ";"}], "\n", RowBox[{"Hf", " ", "=", " ", 
          RowBox[{"jordanwigner", "[", RowBox[{"H", ",", " ", 
              RowBox[{"S", " ", "->", " ", "f"}], ",", " ", RowBox[{"Range", 
                "[", "4", "]"}]}], "]"}]}]}], "Input", 
      CellLabel -> "In[1]:="], 
     Cell[BoxData[RowBox[{FractionBox[RowBox[{"3", " ", "Jz"}], "4"], "-", 
         RowBox[{FractionBox["1", "2"], " ", "Jz", " ", 
