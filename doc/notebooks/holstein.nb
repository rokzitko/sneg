Notebook[{Cell["Momentum transfer in the Holstein model", "Title"], 
  Cell["Second Quantization with SNEG | Chapter 9", "Subtitle"], 
  Cell["Start a fresh Mathematica kernel with SNEG installed. Evaluate the \
cells in order.", "Text"], 
  Cell[BoxData[RowBox[{"Needs", "[", "\"sneg`\"", "]"}]], "Input"], 
  Cell[TextData[{"Follow just the emission of a phonon by an up electron. The \
absorption term is its Hermitian conjugate and the other spin is a second \
copy. This isolates the momentum transfer without expanding four terms \
related by symmetry:"}], "Text"], 
  Cell[CellGroupData[
    {Cell[BoxData[{RowBox[{RowBox[{"snegfermionoperators", "[", 
            RowBox[{"c", ",", " ", "ck"}], "]"}], ";", " ", 
          RowBox[{"snegbosonoperators", "[", RowBox[{"b", ",", " ", "bk"}], 
            "]"}], ";"}], "\n", RowBox[{RowBox[{"snegrealconstants", "[", 
            "g", "]"}], ";", " ", RowBox[{"sneglatticeindexes", "[", 
            RowBox[{RowBox[{"{", "R", "}"}], ",", " ", "Ns"}], "]"}], ";"}], 
        "\n", RowBox[{RowBox[{"snegmomentumindexes", "[", 
            RowBox[{RowBox[{"{", RowBox[{"k", ",", "q"}], "}"}], ",", " ", 
              "Ns"}], "]"}], ";"}], "\n", 
        RowBox[{RowBox[{"emit", " ", "=", " ", RowBox[{"g", " ", 
              RowBox[{"sum", "[", RowBox[{RowBox[{"nc", "[", RowBox[
                     {RowBox[{"number", "[", RowBox[{RowBox[{"c", "[", "R", 
                          "]"}], ",", "UP"}], "]"}], ",", " ", RowBox[
                       {"b", "[", RowBox[{"CR", ",", "R"}], "]"}]}], "]"}], 
                  ",", " ", RowBox[{"{", "R", "}"}]}], "]"}]}]}], ";"}], 
        "\n", RowBox[{RowBox[{"emk", " ", "=", " ", 
            RowBox[{"fourier", "[", RowBox[{RowBox[{"fourier", "[", 
                  RowBox[{"emit", ",", RowBox[{"c", " ", "->", " ", "ck"}], 
                    ",", RowBox[{"R", " ", "->", " ", "k"}]}], "]"}], ",", 
                " ", RowBox[{"b", " ", "->", " ", "bk"}], ",", 
                RowBox[{"R", " ", "->", " ", "q"}]}], "]"}]}], ";"}], "\n", 
        RowBox[{"sumMomentumCanonical", "[", RowBox[{"sumExpand", "[", "emk", 
            "]"}], "]"}]}], "Input", CellLabel -> "In[1]:="], 
     Cell[BoxData[FractionBox[RowBox[{"g", " ", 
          RowBox[{"sum", "[", RowBox[{RowBox[{TagBox[StyleBox[TemplateBox[
                   {"bk", RowBox[{"q"}], "\"\[Dagger]\""}, "Subsuperscript", 
                   SyntaxForm -> SubsuperscriptBox], ScriptSizeMultipliers -> 
                   1, ScriptBaselineShifts -> {1, 1}], DisplayForm], 
                StyleBox["\[CenterDot]", FontColor -> RGBColor[0, 1, 0]], 
                TagBox[StyleBox[TemplateBox[{"ck", RowBox[{"k", TagBox[
                       StyleBox["\"\[UpArrow]\"", FontColor -> RGBColor[1, 0, 
                          0]], StyleForm[#1, FontColor -> RGBColor[1, 0, 
                          0]] & ]}], "\"\[Dagger]\""}, "Subsuperscript", 
                   SyntaxForm -> SubsuperscriptBox], ScriptSizeMultipliers -> 
                   1, ScriptBaselineShifts -> {1, 1}], DisplayForm], 
                StyleBox["\[CenterDot]", FontColor -> RGBColor[0, 1, 0]], 
                TagBox[StyleBox[TemplateBox[{"ck", RowBox[{RowBox[{"k", "+", 
                        "q"}], TagBox[StyleBox["\"\[UpArrow]\"", FontColor -> 
                         RGBColor[1, 0, 0]], StyleForm[#1, FontColor -> 
                          RGBColor[1, 0, 0]] & ]}], "\"\""}, 
                   "Subsuperscript", SyntaxForm -> SubsuperscriptBox], 
                  ScriptSizeMultipliers -> 1, ScriptBaselineShifts -> 
                   {1, 1}], DisplayForm]}], ",", RowBox[{"{", RowBox[
                 {"k", ",", "q"}], "}"}]}], "]"}]}], SqrtBox["Ns"]]], 
      "Output", CellLabel -> "Out[6]="]}, Open]], 
  Cell[TextData[{"The incoming electron momentum exceeds the outgoing one by \
", Cell[BoxData[FormBox["q", TraditionalForm]], "InlineFormula"], ". The site \
sum has removed one independent momentum and left the local coupling divided \
by ", Cell[BoxData[FormBox[SqrtBox[SubscriptBox["N", "s"]], 
        TraditionalForm]], "InlineFormula"], "."}], "Text"], 
  Cell["Source: Second Quantization with SNEG, SNEG documentation project. \
Licensed under Creative Commons Attribution 4.0 International \
(https://creativecommons.org/licenses/by/4.0/).", "Text"]}, 
 StyleDefinitions -> "Default.nb", WindowTitle -> 
  "Momentum transfer in the Holstein model"]
