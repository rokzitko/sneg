% Layout and environments of the SNEG manual (LuaLaTeX, KOMA-Script scrbook).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{snegmanual}[2026/11/27 SNEG manual style]

\RequirePackage{amsmath,mathtools}
\RequirePackage{fontspec}
\RequirePackage{unicode-math}
\setmainfont{texgyrepagella}[
  Extension = .otf, UprightFont = *-regular, BoldFont = *-bold,
  ItalicFont = *-italic, BoldItalicFont = *-bolditalic]
\setmathfont{texgyrepagella-math.otf}
\setsansfont{FiraSans}[Extension = .otf, UprightFont = *-Regular,
  BoldFont = *-SemiBold, ItalicFont = *-Italic, Scale = MatchLowercase]
\setmonofont{FiraMono}[Extension = .otf, UprightFont = *-Regular,
  BoldFont = *-Bold, Scale = 0.84]

\RequirePackage[english]{babel}
\setlength{\emergencystretch}{2em}
\RequirePackage{csquotes}
\RequirePackage{microtype}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{multicol}
\RequirePackage{xcolor}
\RequirePackage{scrlayer-scrpage}
\RequirePackage{verbatim}
\RequirePackage[most]{tcolorbox}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.17}
\RequirePackage{listings}
\RequirePackage{enumitem}
\RequirePackage[backend=biber, style=phys, biblabel=brackets]{biblatex}
\RequirePackage[hidelinks]{hyperref}

\definecolor{snegblue}{RGB}{30,70,140}
\definecolor{sneggray}{gray}{0.45}
\definecolor{snegbg}{gray}{0.955}
\definecolor{snegred}{RGB}{170,30,30}

% Headings and running heads
\addtokomafont{disposition}{\rmfamily}
\addtokomafont{chapter}{\Huge\mdseries}
\addtokomafont{section}{\mdseries}
\addtokomafont{subsection}{\mdseries\itshape}
\addtokomafont{pageheadfoot}{\normalfont\small\itshape}
\pagestyle{scrheadings}
\clearpairofpagestyles
\ohead{\pagemark}
\ihead{\headmark}
\automark[section]{chapter}

% Physics notation
\newcommand{\dg}{^\dagger}
\newcommand{\up}{{\uparrow}}
\newcommand{\dn}{{\downarrow}}
\newcommand{\vS}{\mathbf{S}}
\newcommand{\hc}{\mathrm{h.c.}}
\newcommand{\ket}[1]{\lvert #1\rangle}
\newcommand{\bra}[1]{\langle #1\rvert}
\newcommand{\braket}[2]{\langle #1\vert #2\rangle}
\newcommand{\ev}[1]{\langle #1\rangle}
\newcommand{\comm}[2]{[#1, #2]}
\newcommand{\acomm}[2]{\{#1, #2\}}
\newcommand{\sneg}{\textsc{Sneg}}
\newcommand{\fn}[1]{\texttt{#1}}
\newcommand{\casestudy}[2]{\subsection*{Case study: #2}\begingroup
  \edef\resumechapterblock{\arabic{wlblock}}%
  \input{generated/labs/lab-#1}\setcounter{wlblock}{\resumechapterblock}\endgroup}
\newsavebox{\referenceformula}
\newcommand{\refdisplay}[1]{\par\smallskip\noindent
  \sbox{\referenceformula}{$\displaystyle #1$}%
  \ifdim\wd\referenceformula>\linewidth\resizebox{\linewidth}{!}{\usebox{\referenceformula}}%
  \else\usebox{\referenceformula}\fi\par\smallskip}

% Code: SNEG functions in bold (keyword list generated by build-manual.wl)
\lstdefinestyle{wl}{
  basicstyle=\ttfamily\small, columns=fullflexible, keepspaces=true,
  upquote=true, showstringspaces=false, breaklines=true,
  breakatwhitespace=false, extendedchars=true,
  escapeinside={(*@}{@*)},
  keywordstyle=\color{snegblue}\bfseries,
  stringstyle=\color{black!70},
  commentstyle=\color{sneggray}\itshape,
  morecomment=[s]{(*}{*)}, morestring=[b]",
  aboveskip=0pt, belowskip=0pt}
\InputIfFileExists{generated/keywords.tex}{}{}

% Code blocks in chapters: \begin{wl} ... \end{wl}. The body is skipped; the
% formatted input and the outputs, generated by build-manual.wl, are read
% from generated/<chapter>/<n>.tex.
\newcounter{wlblock}
\newcommand{\wlchapter}{}
\newcommand{\setwlchapter}[1]{\renewcommand{\wlchapter}{#1}\setcounter{wlblock}{0}}
\newcommand{\wlinclude}{%
  \IfFileExists{generated/\wlchapter/\thewlblock.tex}%
    {\input{generated/\wlchapter/\thewlblock.tex}}%
    {\PackageError{snegmanual}{Missing evaluated block \wlchapter/\thewlblock}{Run build-manual.wl}}}
\newenvironment{wl}{\stepcounter{wlblock}\wlinclude\comment}{\endcomment}

\newcommand{\wllabel}[1]{\textcolor{sneggray}{\sffamily\scriptsize #1}}
\newtcblisting{wlinput}[1]{
  enhanced, listing only, listing options={style=wl, language=SNEG},
  colback=snegbg, colframe=snegbg, boxrule=0pt, arc=1pt,
  left=4pt, right=4pt, top=2pt, bottom=2pt,
  before skip=6pt, after skip=3pt,
  overlay={\node[anchor=north east, inner sep=0pt] at ([xshift=-5pt, yshift=-4.5pt]frame.north west) {\wllabel{#1}};}}
\newenvironment{wloutput}[1]
  {\par\addvspace{2pt}\noindent\llap{\wllabel{#1}\hspace{5pt}}\hspace*{4pt}\begin{minipage}[t]{\dimexpr\linewidth-4pt\relax}\raggedright}
  {\end{minipage}\par\addvspace{6pt}}
\lstnewenvironment{wlprint}{\lstset{style=wl, basicstyle=\ttfamily\small\color{sneggray}}}{}
\lstnewenvironment{wlmessage}{\lstset{style=wl, basicstyle=\ttfamily\small\color{snegred}}}{}
\newcommand{\wlgraphics}[2]{\par\addvspace{2pt}\noindent\llap{\wllabel{#1}\hspace{5pt}}%
  \begin{minipage}[t]{\linewidth}\vspace{0pt}\centering\includegraphics[width=0.72\linewidth]{#2}\end{minipage}\par\addvspace{6pt}}

% Boxes
\newtcolorbox{furtherreading}{colback=white, colframe=snegblue!60, boxrule=0.4pt,
  arc=1pt, left=6pt, right=6pt, fonttitle=\small\sffamily\bfseries,
  coltitle=snegblue, colbacktitle=white, title={Further reading},
  fontupper=\small}
\newtcolorbox{pitfall}{colback=snegred!3, colframe=snegred!60, boxrule=0.4pt,
  arc=1pt, left=6pt, right=6pt, fonttitle=\small\sffamily\bfseries,
  coltitle=snegred, colbacktitle=snegred!3, title={Pitfall}, fontupper=\small}

% Exercises with solutions in the appendix
\newcounter{exercise}[chapter]
\renewcommand{\theexercise}{\thechapter.\arabic{exercise}}
\newenvironment{exercise}[1][]
  {\par\addvspace{8pt}\refstepcounter{exercise}\noindent\textbf{Exercise \theexercise}%
   \if\relax\detokenize{#1}\relax\else\ \textit{(#1)}\fi.\enspace\ignorespaces}
  {\par\addvspace{6pt}}
\newenvironment{solution}[1]
  {\par\addvspace{10pt}\noindent\textbf{Solution of Exercise~\ref{#1}.}\enspace\ignorespaces}
  {\par}

\endinput
